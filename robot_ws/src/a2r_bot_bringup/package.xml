<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a2r_bot_bringup</name>
  <version>2.0.0</version>
  <description>
    Top-level launch files. One entry point per operating mode:
    robot_base, follow, slam, navigation and pet. Everything else is
    composed from these.
  </description>
  <maintainer email="a2r.bot@example.com">A2R Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>a2r_bot_description</depend>
  <depend>a2r_bot_arduino</depend>
  <depend>a2r_bot_sensor_fusion</depend>
  <depend>a2r_bot_follow</depend>
  <depend>a2r_bot_slam</depend>
  <depend>a2r_bot_pet</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
