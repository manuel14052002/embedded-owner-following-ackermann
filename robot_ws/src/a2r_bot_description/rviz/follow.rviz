# GENERATED by scripts/gen_rviz_configs.py — do not hand-edit.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.55
  Help Height: 0
  Tree Height: 720
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - ''
  Splitter Ratio: 0.5
- Class: rviz_common/Tool Properties
  Name: Tool Properties
  Expanded:
  - ''
  Splitter Ratio: 0.6
Visualization Manager:
  Class: ''
  Name: root
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Color: 50; 54; 62
    Cell Size: 0.5
    Plane Cell Count: 24
    Line Style:
      Line Width: 0.01
      Value: Lines
    Alpha: 0.4
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/RobotModel
    Name: A2R_bot
    Enabled: true
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1.0
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    TF Prefix: ''
    Update Interval: 0
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.15
    Frame Timeout: 15.0
    Update Interval: 0
    Frames:
      All Enabled: true
  - Class: rviz_default_plugins/LaserScan
    Name: Lidar raw
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Style: Flat Squares
    Size (m): 0.015
    Color: 30; 200; 255
    Color Transformer: FlatColor
    Alpha: 1.0
    Decay Time: 0.0
    Position Transformer: XYZ
    Queue Size: 10
    Selectable: true
  - Class: rviz_default_plugins/Map
    Name: Local costmap
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_costmap
    Alpha: 0.65
    Color Scheme: costmap
    Draw Behind: true
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap_updates
  - Class: rviz_default_plugins/PointCloud2
    Name: Local costmap (cloud)
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_costmap/cloud
    Style: Boxes
    Size (m): 0.05
    Size (Pixels): 3
    Alpha: 0.6
    Color Transformer: Intensity
    Channel Name: intensity
    Use rainbow: false
    Invert Rainbow: false
    Min Color: 0; 170; 255
    Max Color: 255; 0; 255
    Autocompute Intensity Bounds: false
    Min Intensity: 1
    Max Intensity: 100
    Decay Time: 0
    Position Transformer: XYZ
    Queue Size: 10
    Selectable: true
    Use Fixed Frame: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Robot status
    Enabled: true
    Namespaces:
      robot_status: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_status/markers
  - Class: rviz_default_plugins/MarkerArray
    Name: Candidate arcs
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_planner/trajectories
    Namespaces: {}
  - Class: rviz_default_plugins/MarkerArray
    Name: Chosen arc
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_planner/best_traj
    Namespaces: {}
  - Class: rviz_default_plugins/Path
    Name: Local path
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_planner/path
    Color: 80; 220; 120
    Alpha: 1.0
    Line Style: Lines
    Line Width: 0.025
    Buffer Length: 1
    Offset:
      x: 0
      y: 0
      z: 0.01
    Pose Style: None
  - Class: rviz_default_plugins/Marker
    Name: Jetson wish
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_planner/desired_cmd
    Namespaces: {}
  - Class: rviz_default_plugins/Marker
    Name: Planner state
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /local_planner/state
    Namespaces: {}
  - Class: rviz_default_plugins/Odometry
    Name: Fused odom
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /odometry/filtered
    Keep: 120
    Position Tolerance: 0.05
    Angle Tolerance: 0.05
    Shape:
      Alpha: 1.0
      Color: 180; 130; 255
      Head Length: 0.06
      Head Radius: 0.03
      Shaft Length: 0.14
      Shaft Radius: 0.012
      Value: Arrow
    Covariance:
      Value: false
  - Class: rviz_default_plugins/Odometry
    Name: Raw odom
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /odom
    Keep: 1
    Position Tolerance: 0.05
    Angle Tolerance: 0.05
    Shape:
      Alpha: 1.0
      Color: 235; 240; 250
      Head Length: 0.06
      Head Radius: 0.03
      Shaft Length: 0.14
      Shaft Radius: 0.012
      Value: Arrow
    Covariance:
      Value: false
  Enabled: true
  Global Options:
    Background Color: 22; 24; 28
    Fixed Frame: odom
    Frame Rate: 30
    Default Light: true
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.068
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Orbit
      Distance: 2.6
      Pitch: 0.68
      Yaw: 2.36
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.06
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved:
    - Class: rviz_default_plugins/Orbit
      Name: Chase
      Distance: 1.2
      Pitch: 0.38
      Yaw: 3.14
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.08
      Target Frame: base_link
      Value: Orbit (rviz)
      Near Clip Distance: 0.01
      Focal Shape Size: 0.05
      Focal Shape Fixed Size: false
      Invert Z Axis: false
    - Class: rviz_default_plugins/TopDownOrtho
      Name: Map
      Scale: 90.0
      Angle: 0.0
      X: 0.0
      Y: 0.0
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
      Near Clip Distance: 0.01
      Invert Z Axis: false
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Tool Properties:
    collapsed: true
  Height: 900
  Width: 1500
  X: 60
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: ''
