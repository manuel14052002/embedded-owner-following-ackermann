<?xml version="1.0"?>
<!--
  a2r_bot.gazebo.xacro — simulation-only additions
  ════════════════════════════════════════════════════════════════════════════
  Included ONLY when use_gazebo:=true, so the hardware model stays clean.
  Gives the sim: friction on the tyres, a ray sensor standing in for the
  lidar, an IMU plugin and two sonar rays matching the DYP-A21s. Topic names
  are identical to the real robot, so every node in this workspace runs
  against the simulator without a single remap.
  ════════════════════════════════════════════════════════════════════════════
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="a2r_gazebo">

    <!-- Tyre friction: high longitudinal, lower lateral so it can actually slide -->
    <xacro:macro name="wheel_friction" params="name">
      <gazebo reference="${name}">
        <mu1>1.1</mu1><mu2>0.9</mu2>
        <kp>1000000.0</kp><kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <material>Gazebo/FlatBlack</material>
      </gazebo>
    </xacro:macro>
    <xacro:wheel_friction name="front_left_wheel"/>
    <xacro:wheel_friction name="front_right_wheel"/>
    <xacro:wheel_friction name="rear_left_wheel"/>
    <xacro:wheel_friction name="rear_right_wheel"/>

    <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>

    <!-- LIDAR → /scan, matching a 7 Hz single-channel unit -->
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>7.0</update_rate>
        <ray>
          <scan><horizontal>
            <samples>720</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
          </horizontal></scan>
          <range><min>0.10</min><max>8.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- IMU → /imu/data_raw, same topic the Arduino bridge publishes -->
    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=/imu/data_raw</remapping></ros>
          <frame_name>imu_link</frame_name>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <!-- DYP-A21 stand-ins: narrow cones → /ultrasonic/front, /ultrasonic/rear -->
    <xacro:macro name="sonar_sim" params="link topic">
      <gazebo reference="${link}">
        <sensor name="${link}_sonar" type="ray">
          <update_rate>10.0</update_rate>
          <ray>
            <scan>
              <horizontal><samples>7</samples><resolution>1</resolution>
                <min_angle>-0.26</min_angle><max_angle>0.26</max_angle></horizontal>
              <vertical><samples>5</samples><resolution>1</resolution>
                <min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical>
            </scan>
            <range><min>0.02</min><max>5.0</max><resolution>0.003</resolution></range>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
          </ray>
          <plugin name="${link}_plugin" filename="libgazebo_ros_ray_sensor.so">
            <ros><remapping>~/out:=${topic}</remapping></ros>
            <output_type>sensor_msgs/Range</output_type>
            <radiation_type>ultrasound</radiation_type>
            <frame_name>${link}</frame_name>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:macro>
    <xacro:sonar_sim link="ultrasonic_front_link" topic="/ultrasonic/front"/>
    <xacro:sonar_sim link="ultrasonic_rear_link"  topic="/ultrasonic/rear"/>

    <!-- Ackermann drive: consumes /cmd_vel exactly like the real firmware -->
    <gazebo>
      <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
        <ros><remapping>cmd_vel:=cmd_vel</remapping><remapping>odom:=odom</remapping></ros>
        <update_rate>50.0</update_rate>
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
        <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
        <left_steering_joint>front_left_steer_joint</left_steering_joint>
        <right_steering_joint>front_right_steer_joint</right_steering_joint>
        <max_steer>0.5236</max_steer>
        <max_speed>1.2</max_speed>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_wheel_tf>false</publish_wheel_tf>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
