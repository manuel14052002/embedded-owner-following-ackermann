<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a2r_bot_sensor_fusion</name>
  <version>2.0.0</version>
  <description>
    Kalman-filter sensor fusion: Madgwick/Mahony attitude estimation from
    the GY-91, an extended Kalman filter for the planar pose, and a per-
    sector linear Kalman filter that merges the lidar scan with the two
    DYP-A21 ultrasonic sensors into /scan/fused.
  </description>
  <maintainer email="a2r.bot@example.com">A2R Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
