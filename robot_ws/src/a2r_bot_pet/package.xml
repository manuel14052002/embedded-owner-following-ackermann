<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a2r_bot_pet</name>
  <version>2.0.0</version>
  <description>
    Animated robot face for PET mode. Renders eyes and mouth on the
    800x480 LCD with pygame and maps the state strings published by the
    Jetson Nano onto expressions. No state machine lives here: the Jetson
    owns the FSM, this package only reacts.
  </description>
  <maintainer email="a2r.bot@example.com">A2R Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-pygame</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
